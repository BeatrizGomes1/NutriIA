generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserObjective {
  weight_loss
  muscle_gain

  @@map("user_objective")
}

enum CaptureType {
  ean
  label_photo

  @@map("capture_type")
}

enum SourceStatus {
  found
  not_found
  insufficient

  @@map("source_status")
}

enum AnalysisVerdict {
  recommended
  attention
  avoid
  insufficient

  @@map("analysis_verdict")
}

enum ConfidenceState {
  sufficient
  insufficient

  @@map("confidence_state")
}

enum IngredientMatchType {
  allergen
  avoided_ingredient
  preference
  hidden_term
  none

  @@map("ingredient_match_type")
}

model UserProfile {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name_or_nickname      String           @db.VarChar(120)
  email                 String           @unique @db.VarChar(320)
  age_range             String?          @db.VarChar(40)
  objective             UserObjective
  declared_allergies    String[]         @default([])
  avoided_ingredients   String[]         @default([])
  food_preferences      String[]         @default([])
  onboarding_completed  Boolean          @default(false)
  created_at            DateTime         @default(now()) @db.Timestamptz(6)
  updated_at            DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  product_captures      ProductCapture[]
  analysis_results      AnalysisResult[]

  @@map("user_profiles")
}

model ProductCapture {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String       @db.Uuid
  product_id       String?      @db.Uuid
  capture_type     CaptureType
  ean              String?      @db.VarChar(32)
  image_reference  String?      @db.Text
  captured_at      DateTime     @default(now()) @db.Timestamptz(6)
  source_status    SourceStatus
  user             UserProfile  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product          Product?     @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([user_id, captured_at(sort: Desc)])
  @@index([product_id, captured_at(sort: Desc)])
  @@index([ean])
  @@map("product_captures")
}

model Product {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ean                      String?          @unique @db.VarChar(32)
  name                     String?          @db.VarChar(240)
  brand                    String?          @db.VarChar(160)
  serving_information      Json?            @db.JsonB
  nutrition_table          Json?            @db.JsonB
  ingredients_raw          String?          @db.Text
  ingredients_normalized   String[]         @default([])
  source_reference         String?          @db.Text
  source_updated_at        DateTime?        @db.Timestamptz(6)
  created_at               DateTime         @default(now()) @db.Timestamptz(6)
  updated_at               DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  captures                 ProductCapture[]
  analysis_results         AnalysisResult[]

  @@index([name, brand])
  @@index([source_updated_at])
  @@map("products")
}

model AnalysisResult {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String             @db.Uuid
  product_id          String             @db.Uuid
  cache_key           String?            @unique @db.VarChar(64)
  verdict             AnalysisVerdict
  ui_label            String             @db.VarChar(80)
  summary             String             @db.Text
  critical_alerts     String[]           @default([])
  reasons             String[]           @default([])
  matched_restrictions String[]          @default([])
  confidence_state    ConfidenceState
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  user                UserProfile        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [product_id], references: [id], onDelete: Restrict)
  ingredient_matches  IngredientMatch[]

  @@index([user_id, created_at(sort: Desc)])
  @@index([product_id, created_at(sort: Desc)])
  @@map("analysis_results")
}

model IngredientMatch {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysis_result_id    String             @db.Uuid
  raw_name              String             @db.VarChar(240)
  normalized_name       String             @db.VarChar(240)
  match_type            IngredientMatchType
  matched_profile_term  String?            @db.VarChar(240)
  explanation           String             @db.Text
  evidence_reference    String?            @db.Text
  analysis_result       AnalysisResult     @relation(fields: [analysis_result_id], references: [id], onDelete: Cascade)

  @@index([analysis_result_id])
  @@index([normalized_name])
  @@map("ingredient_matches")
}
