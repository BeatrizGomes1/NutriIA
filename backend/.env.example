# Configurações da API e do ambiente de desenvolvimento
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Informe a chave da API do Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
NUTRITION_PROVIDER=mock

# Banco PostgreSQL usado pelo Prisma e pelos serviços Python
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/nutriia?schema=public"
ANALYSIS_PROMPT_VERSION=v0008
