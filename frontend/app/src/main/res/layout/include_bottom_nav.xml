<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_nav"
    android:elevation="10dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/navInicio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/navInicioIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_home" />

        <TextView
            android:id="@+id/navInicioLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_home"
            android:textColor="@color/green_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navHistorico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/navHistoricoIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_history"
            android:src="@drawable/ic_history" />

        <TextView
            android:id="@+id/navHistoricoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_history"
            android:textColor="@color/nav_unselected"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navEscanear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_nav_scan">

            <ImageView
                android:id="@+id/navEscanearIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/nav_scan"
                android:src="@drawable/ic_barcode"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/navEscanearLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_scan"
            android:textColor="@color/nav_unselected"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navRestricoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/navRestricoesIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_restrictions"
            android:src="@drawable/ic_search" />

        <TextView
            android:id="@+id/navRestricoesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_restrictions"
            android:textColor="@color/nav_unselected"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/navPerfilIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_profile"
            android:src="@drawable/ic_profile" />

        <TextView
            android:id="@+id/navPerfilLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_profile"
            android:textColor="@color/nav_unselected"
            android:textSize="11sp"
            tools:ignore="SmallSp" />
    </LinearLayout>
</LinearLayout>
